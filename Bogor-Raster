// =====================================================
// 6. CHIRPS RAINFALL ACCUMULATION
// =====================================================

var chirps = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterBounds(roi);

function rainfallAccumulation(endDate, days) {
  endDate = ee.Date(endDate);
  var startDate = endDate.advance(-days, 'day');

  return chirps
    .filterDate(startDate, endDate)
    .select('precipitation')
    .sum()
    .clip(roi)
    .rename('rain_' + days + 'd');
}

var rain1d = rainfallAccumulation(eventDate, 1);
var rain3d = rainfallAccumulation(eventDate, 3);
var rain7d = rainfallAccumulation(eventDate, 7);
var rain14d = rainfallAccumulation(eventDate, 14);
var rain30d = rainfallAccumulation(eventDate, 30);


// =====================================================
// 7. SENTINEL-2 NDVI TEMPORAL
// =====================================================

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 40));

function maskS2clouds(image) {
  var scl = image.select('SCL');

  var mask = scl.neq(3)     // cloud shadow
    .and(scl.neq(8))        // cloud medium probability
    .and(scl.neq(9))        // cloud high probability
    .and(scl.neq(10))       // cirrus
    .and(scl.neq(11));      // snow

  return image.updateMask(mask);
}

function ndviBeforeDate(endDate, days) {
  endDate = ee.Date(endDate);
  var startDate = endDate.advance(-days, 'day');

  var composite = s2
    .filterDate(startDate, endDate)
    .map(maskS2clouds)
    .median()
    .clip(roi);

  return composite
    .normalizedDifference(['B8', 'B4'])
    .rename('ndvi_' + days + 'd');
}

var ndvi30d = ndviBeforeDate(eventDate, ndviShortWindow);
var ndvi90d = ndviBeforeDate(eventDate, ndviLongWindow);

var ndviChange = ndvi30d
  .subtract(ndvi90d)
  .rename('ndvi_change');


// =====================================================
// 8. DYNAMIC WORLD LULC
// =====================================================

var dw = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
  .filterBounds(roi);

function dynamicWorldBeforeDate(endDate, days) {
  endDate = ee.Date(endDate);
  var startDate = endDate.advance(-days, 'day');

  var dwPeriod = dw
    .filterDate(startDate, endDate)
    .filterBounds(roi);

  var label = dwPeriod
    .select('label')
    .mode()
    .clip(roi)
    .rename('dynamic_world_lulc');

  var waterProb = dwPeriod
    .select('water')
    .mean()
    .clip(roi)
    .rename('water_probability');

  var treesProb = dwPeriod
    .select('trees')
    .mean()
    .clip(roi)
    .rename('trees_probability');

  var grassProb = dwPeriod
    .select('grass')
    .mean()
    .clip(roi)
    .rename('grass_probability');

  var floodedVegetationProb = dwPeriod
    .select('flooded_vegetation')
    .mean()
    .clip(roi)
    .rename('flooded_vegetation_probability');

  var cropsProb = dwPeriod
    .select('crops')
    .mean()
    .clip(roi)
    .rename('crops_probability');

  var shrubProb = dwPeriod
    .select('shrub_and_scrub')
    .mean()
    .clip(roi)
    .rename('shrub_probability');

  var builtProb = dwPeriod
    .select('built')
    .mean()
    .clip(roi)
    .rename('built_probability');

  var bareProb = dwPeriod
    .select('bare')
    .mean()
    .clip(roi)
    .rename('bare_probability');

  var snowIceProb = dwPeriod
    .select('snow_and_ice')
    .mean()
    .clip(roi)
    .rename('snow_ice_probability');

  return label
    .addBands(waterProb)
    .addBands(treesProb)
    .addBands(grassProb)
    .addBands(floodedVegetationProb)
    .addBands(cropsProb)
    .addBands(shrubProb)
    .addBands(builtProb)
    .addBands(bareProb)
    .addBands(snowIceProb);
}

var dynamicWorldStack = dynamicWorldBeforeDate(
