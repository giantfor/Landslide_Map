function resetMapWithLayer(image, vis, layerName, opacity) {
  Map.layers().reset();

  Map.addLayer(
    image,
    vis,
    layerName,
    true,
    opacity
  );

  Map.addLayer(
    boundary,
    boundaryVis,
    'Bogor Regency + Bogor City Boundary',
    true,
    1
  );
}


function addRainfallLegend(vis, title) {
  legendPanel.add(
    makeColorBar(
      vis.palette,
      vis.min,
      vis.max,
      title,
      'mm'
    )
  );

  legendPanel.add(makeLegendRow('#FFFFFF', 'Low rainfall'));
  legendPanel.add(makeLegendRow('#ADD8E6', 'Moderate rainfall'));
  legendPanel.add(makeLegendRow('#0000FF', 'High rainfall'));

  if (vis.palette.length === 4) {
    legendPanel.add(makeLegendRow('#4B0082', 'Very high rainfall'));
  }

  if (vis.palette.length === 5) {
    legendPanel.add(makeLegendRow('#00008B', 'Very high rainfall'));
    legendPanel.add(makeLegendRow('#4B0082', 'Extreme rainfall'));
  }
}


function addProbabilityLegend(title) {
