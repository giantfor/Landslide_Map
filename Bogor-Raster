function makeLegendRow(color, name) {
  var colorBox = ui.Label({
    style: {
      backgroundColor: color,
      padding: '8px',
      margin: '0 0 4px 0'
    }
  });

  var description = ui.Label({
    value: name,
    style: {
      margin: '0 0 4px 6px',
      fontSize: '12px'
    }
  });

  return ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
}


function makeColorBar(palette, min, max, title, unit) {
  var legendPanelLocal = ui.Panel({
    style: {
      padding: '8px 0 0 0',
      backgroundColor: 'white'
    }
  });

  legendPanelLocal.add(ui.Label({
    value: title,
    style: {
      fontWeight: 'bold',
      fontSize: '13px',
      margin: '0 0 6px 0'
    }
  }));

  var lon = ee.Image.pixelLonLat().select('longitude');
  var gradient = lon.multiply((max - min) / 100.0).add(min);

  var legendImage = gradient.visualize({
    min: min,
    max: max,
    palette: palette
  });

  var thumbnail = ui.Thumbnail({
    image: legendImage,
    params: {
      bbox: [0, 0, 100, 10],
      dimensions: '250x14'
    },
    style: {
      stretch: 'horizontal',
      margin: '0 0 4px 0',
      maxHeight: '24px'
    }
  });

  legendPanelLocal.add(thumbnail);

  var labels = ui.Panel({
    widgets: [
      ui.Label(min + ' ' + unit, {
        fontSize: '11px',
        margin: '0 8px 0 0'
      }),
      ui.Label(((min + max) / 2) + ' ' + unit, {
        fontSize: '11px',
        margin: '0 8px 0 8px',
        textAlign: 'center',
        stretch: 'horizontal'
      }),
      ui.Label(max + ' ' + unit, {
        fontSize: '11px',
        margin: '0 0 0 8px'
      })
    ],
    layout: ui.Panel.Layout.Flow('horizontal')
  });

  legendPanelLocal.add(labels);

  return legendPanelLocal;
}


